# Dukaan AI environment variables
# Copy this to .env and fill values

# Required
GROQ_API_KEY=your_groq_key_here
DATABASE_URL=postgresql://user:password@host:port/dbname
SECRET_KEY=change-this-to-a-random-long-string

# WhatsApp Cloud API (auto-send)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_API_VERSION=v20.0

# ---- NEW: Agentic AI ----
# Worker service URL (Railway/Render/Fly.io)
WORKER_URL=http://localhost:8001
WORKER_API_KEY=generate-a-long-random-string-here

# WhatsApp webhook (Meta app settings)
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=dukaan-ai-verify

# Feature flag
AGENT_ENABLED=true

# Voice (Phase 3 — abhi khali chhoro)
VAPI_API_KEY=
VAPI_PHONE_ID=